# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# --- Database ---------------------------------------------------------------
# LOCAL (through the Cloud SQL Auth Proxy, see README):
#   postgresql://callzie_app:PASSWORD@127.0.0.1:5432/callzie
# CLOUD RUN (unix socket, injected by the deploy — do not set by hand):
#   postgresql://callzie_app:PASSWORD@/callzie?host=/cloudsql/callzie:us-central1:callzie-db
DATABASE_URL=

# --- GCP (written by scripts/setup-infrastructure.sh) ------------------------
GCP_PROJECT_ID=
GCP_REGION=us-central1
CLOUDSQL_CONNECTION_NAME=

# --- Retell -----------------------------------------------------------------
RETELL_API_KEY=
# NOT an env var. Four Agents exist, one per Business Type (SPEC.md §4), and
# their ids live in the `retell_agents` table — written by `npm run create-agents`
# and read by the Web Call path. See ADR-0006.

# The US number you bought from Retell, in E.164. Read by the Phone Call path
# (issue #19). Blank means a flagged account's Phone Calls are refused before
# anything is spent — no Quota, no Call row — rather than failing at Retell.
# Unflagged accounts place Web Calls and never read this, which is why it is
# optional on the Settings configuration panel. Buying the number needs KYC:
# see docs/runbooks/phone-call-preflight.md.
RETELL_FROM_NUMBER=
# NOT a separate secret. Retell signs webhooks with whichever API key is
# designated "Set as Webhook Key" in the dashboard — this must be that exact
# key, or every webhook fails verification as a silent 401. See
# docs/verification.md A8.
RETELL_WEBHOOK_SECRET=

# --- Anthropic (transcript extraction) --------------------------------------
ANTHROPIC_API_KEY=

# --- Clerk ------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Google Calendar (issue #20 — optional, app must work without it) --------
# The authorised redirect URI is {APP_URL}/api/google/callback, and it must be
# registered verbatim in the Google Cloud console's OAuth client. Google matches
# it exactly — a trailing slash, http vs https, or the localhost URI left in
# place after deploying all fail as redirect_uri_mismatch at the consent screen,
# never as a misconfiguration the app can report. Both the local and the
# deployed URI need registering if you use both.
# Per ADR-0004 the OAuth app stays in **Testing** status: the calendar.events
# scope is sensitive and public use needs Google verification, which reportedly
# runs to weeks. So only accounts listed as test users can connect at all, and
# adding one is a console step, not a product one.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts businesses.google_refresh_token at rest, which SPEC.md §5 annotates
# as "encrypted at rest" and the column does not currently do. See ADR-0009.
# 32 random bytes, base64 — this is an AES-256 key that gets decoded, not a
# passphrase and not hex — a value that decodes to any other length is not a key:
#   openssl rand -base64 32
# Losing or rotating it makes every stored token undecryptable, and every
# Business has to reconnect Google. That is survivable only because ADR-0004
# keeps Google optional — nothing else in Callzie stops working.
TOKEN_ENCRYPTION_KEY=

# --- Internal ----------------------------------------------------------------
# Authenticates the Agent's Tool calls and the extraction endpoint. Issued by
# nobody — generated locally by scripts/setup-infrastructure.sh.
# Baked into the Agents' Tool headers at creation time, so rotating it means
# re-running `npm run create-agents` or every Tool call starts failing.
INTERNAL_SECRET=

# --- Build inputs (baked into the image by `next build`) ---------------------
# Next encrypts the variables an inline Server Action closes over, and salts the
# action's own id with the same key. Both happen at BUILD time, so this is a
# Docker build arg, not a Cloud Run secret — setting it only at runtime would
# change the encryption and not the id, which is worse than not setting it at
# all. See docs/adr/0008-server-actions-key-is-a-build-input.md.
#
# A stability value, not a per-environment one. The same key in every
# environment is correct; a fresh key per deploy is the bug it exists to
# prevent. Rotating it renames every Server Action, so references already
# rendered into someone's open tab stop resolving until they reload.
#
# Optional locally — `next dev` generates one and caches it for 14 days.
# Required for any deployed build. Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# --- App --------------------------------------------------------------------
# Public base URL. Locally http://localhost:3000; in production the Cloud Run
# service URL. Retell's webhook is configured at {APP_URL}/api/webhooks/retell.
# The Agents' webhook and Tool URLs are baked in from this at creation time, and
# Retell calls them from its own servers — so `npm run create-agents` refuses a
# localhost value, and must be re-run whenever the deployed URL changes.
APP_URL=http://localhost:3000
